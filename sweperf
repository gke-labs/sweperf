#!/bin/bash
set -eo pipefail

usage() {
    echo "Usage: $0 <command> [args...]"
    echo ""
    echo "Commands:"
    echo "  create-cluster <PROJECT_ID> <REGION> <CLUSTER_NAME> <REPO_NAME>   Creates GKE cluster and installs sandbox"
    echo "  generate-images --project <PROJECT> --region <REGION> --repo <REPO> [--limit LIMIT] [--run RUN_NAME]"
    echo "                                                                    Generates, pushes, and prepulls SWE-bench images"
    echo "  run-benchmark <DURATION_SECONDS> <CONCURRENCY>                    Runs the benchmark and collects metrics"
    echo ""
    exit 1
}

if [ $# -lt 1 ]; then
    usage
fi

COMMAND=$1
shift

case "$COMMAND" in
    create-cluster)
        if [ "$#" -ne 4 ]; then
            echo "Usage: $0 create-cluster <PROJECT_ID> <REGION> <CLUSTER_NAME> <REPO_NAME>"
            exit 1
        fi
        PROJECT_ID=$1
        REGION=$2
        CLUSTER_NAME=$3
        REPO_NAME=$4

        echo "=== 1. Creating GKE Cluster ==="
        gcloud container clusters create "$CLUSTER_NAME" \
            --project="$PROJECT_ID" \
            --zone="${REGION}-b" \
            --machine-type="c4-standard-16" \
            --disk-size="500GB" \
            --disk-type="hyperdisk-balanced" \
            --num-nodes=3 \
            --default-max-pods-per-node=256 \
            --scopes="gke-default,storage-rw" || echo "Cluster may already exist."
        gcloud container clusters get-credentials "$CLUSTER_NAME" --zone="${REGION}-b" --project="$PROJECT_ID"

        echo "Waiting for cluster API to become reachable..."
        for i in {1..10}; do
            if kubectl get nodes; then
                echo "Cluster is reachable."
                break
            fi
            echo "Waiting for cluster... ($i/10)"
            sleep 15
        done

        echo "=== 2. Creating Artifact Registry Repo ==="
        gcloud artifacts repositories create "$REPO_NAME" \
            --repository-format=docker \
            --location="$REGION" \
            --project="$PROJECT_ID" || echo "Repo may already exist."

        gcloud auth configure-docker "$REGION-docker.pkg.dev" --quiet

        echo "=== 3. Granting GKE nodes access to Artifact Registry ==="
        PROJECT_NUMBER=$(gcloud projects describe "$PROJECT_ID" --format="value(projectNumber)")
        gcloud artifacts repositories add-iam-policy-binding "$REPO_NAME" \
            --location="$REGION" \
            --project="$PROJECT_ID" \
            --member="serviceAccount:${PROJECT_NUMBER}-compute@developer.gserviceaccount.com" \
            --role="roles/artifactregistry.reader"

        echo "=== 4. Installing Agent Sandbox ==="
        AGENT_SANDBOX_DIR=$(mktemp -d)
        echo "Cloning fresh agent-sandbox repository to $AGENT_SANDBOX_DIR..."
        git clone https://github.com/kubernetes-sigs/agent-sandbox.git "$AGENT_SANDBOX_DIR"

        cd "$AGENT_SANDBOX_DIR"
        IMAGE_PREFIX="$REGION-docker.pkg.dev/$PROJECT_ID/$REPO_NAME/"
        echo "Building Agent Sandbox controller and pushing to $IMAGE_PREFIX"
        ./dev/tools/push-images --image-prefix="$IMAGE_PREFIX" --controller-only

        echo "Deploying to Kubernetes cluster"
        ./dev/tools/deploy-to-kube --image-prefix="$IMAGE_PREFIX" --extensions

        cd - > /dev/null
        rm -rf "$AGENT_SANDBOX_DIR"

        echo "=== Done! Cluster Setup Complete. ==="
        echo "Cluster: $CLUSTER_NAME"
        ;;

    generate-images)
        PROJECT_ID=""
        REGION=""
        REPO_NAME=""
        LIMIT=5
        RUN_NAME="20251120_livesweagent_gemini-3-pro-preview"

        while [[ "$#" -gt 0 ]]; do
            case $1 in
                --project) PROJECT_ID="$2"; shift ;;
                --region) REGION="$2"; shift ;;
                --repo) REPO_NAME="$2"; shift ;;
                --limit) LIMIT="$2"; shift ;;
                --run) RUN_NAME="$2"; shift ;;
                *) echo "Unknown parameter passed: $1"; exit 1 ;;
            esac
            shift
        done

        if [ -z "$PROJECT_ID" ] || [ -z "$REGION" ] || [ -z "$REPO_NAME" ]; then
            echo "Usage: $0 generate-images --project <PROJECT_ID> --region <REGION> --repo <REPO_NAME> [--limit <LIMIT>] [--run <RUN_NAME>]"
            echo "  --run defaults to 20251120_livesweagent_gemini-3-pro-preview"
            exit 1
        fi

        echo "=== 1. Generating and Pushing Test Images ==="
        IMAGE_PREFIX="$REGION-docker.pkg.dev/$PROJECT_ID/$REPO_NAME/"
        GENERATED_IMAGES_FILE="$(pwd)/generated_images.txt"

        VENV_DIR="$(dirname "$0")/.venv"
        if [ ! -d "$VENV_DIR" ]; then
            echo "Creating virtual environment at $VENV_DIR..."
            python3 -m venv "$VENV_DIR"
        fi
        source "$VENV_DIR/bin/activate"

        pip install -i https://pypi.org/simple -r "$(dirname "$0")/generate-images/requirements.txt"
        GENERATED_YAML_FILE="$(pwd)/generated_images.yaml"
        python3 "$(dirname "$0")/generate-images/generate.py" --build --push --image-prefix "$IMAGE_PREFIX" --output-list "$GENERATED_IMAGES_FILE" --output-yaml "$GENERATED_YAML_FILE" --limit "$LIMIT" --run "$RUN_NAME"

        echo "=== 2. Pre-pulling SWE-bench Images to Target Nodes ==="
        chmod +x "$(dirname "$0")/generate-images/prepull_images.py"
        if [ -f "$GENERATED_IMAGES_FILE" ]; then
            "$(dirname "$0")/generate-images/prepull_images.py" --image-file "$GENERATED_IMAGES_FILE"
        else
            echo "Warning: $GENERATED_IMAGES_FILE not found, skipping prepull."
        fi
        
        echo "=== Done! Images generated and pushed. ==="
        ;;

    run-benchmark)
        if [ "$#" -ne 2 ]; then
            echo "Usage: $0 run-benchmark <DURATION_SECONDS> <CONCURRENCY>"
            exit 1
        fi
        DURATION=$1
        CONCURRENCY=$2

        echo "Starting metrics collection in background..."
        rm -f node_metrics.txt
        (
          END_TIME=$((SECONDS + DURATION))
          while [ $SECONDS -lt $END_TIME ]; do
            kubectl top nodes --no-headers >> node_metrics.txt 2>/dev/null || true
            sleep 10
          done
        ) &
        METRICS_PID=$!

        echo "Starting submitter ($DURATION seconds, $CONCURRENCY pods)..."
        ./benchmark/submitter.sh benchmark/pod_template.yaml $CONCURRENCY $DURATION generated_images.txt

        echo "Submitter finished. Stopping metrics collection..."
        kill $METRICS_PID 2>/dev/null || true
        wait $METRICS_PID 2>/dev/null || true

        echo "Generating report..."
        python3 benchmark/process_metrics.py > report.md
        cat report.md
        ;;

    *)
        echo "Unknown command: $COMMAND"
        usage
        ;;
esac
